{
  "name": "events_search_index",
  "collection": "events",
  "description": "Atlas Search index for events collection with text search and faceted filtering",
  "generated": "2025-10-28",
  "prdReference": "v0.3",
  "mappings": {
    "dynamic": false,
    "fields": {
      "title": {
        "type": "string",
        "analyzer": "lucene.standard",
        "searchAnalyzer": "lucene.standard",
        "multi": {
          "keywordLowercase": {
            "type": "string",
            "analyzer": "lucene.keyword",
            "searchAnalyzer": "lucene.keyword"
          }
        }
      },
      "description": {
        "type": "string",
        "analyzer": "lucene.standard",
        "searchAnalyzer": "lucene.standard"
      },
      "organizationId": {
        "type": "objectId"
      },
      "startTime": {
        "type": "date"
      },
      "endTime": {
        "type": "date"
      },
      "status": {
        "type": "string",
        "analyzer": "lucene.keyword"
      },
      "visibility": {
        "type": "string",
        "analyzer": "lucene.keyword"
      },
      "location": {
        "type": "document",
        "fields": {
          "type": {
            "type": "string",
            "analyzer": "lucene.keyword"
          },
          "name": {
            "type": "string",
            "analyzer": "lucene.standard"
          },
          "city": {
            "type": "string",
            "analyzer": "lucene.keyword",
            "multi": {
              "text": {
                "type": "string",
                "analyzer": "lucene.standard"
              }
            }
          },
          "state": {
            "type": "string",
            "analyzer": "lucene.keyword"
          },
          "country": {
            "type": "string",
            "analyzer": "lucene.keyword"
          },
          "postalCode": {
            "type": "string",
            "analyzer": "lucene.keyword"
          },
          "coordinates": {
            "type": "geo",
            "indexShapes": true
          }
        }
      },
      "tags": {
        "type": "string",
        "analyzer": "lucene.keyword",
        "multi": {
          "text": {
            "type": "string",
            "analyzer": "lucene.standard"
          }
        }
      },
      "pricing": {
        "type": "document",
        "fields": {
          "isFree": {
            "type": "boolean"
          },
          "amount": {
            "type": "number",
