{
  "name": "group-ops-platform",
  "version": "0.4.0",
  "description": "Infra-ready platform for managing group events, RSVPs, attendance, and payments",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets && npm run package-lambdas",
    "copy-assets": "mkdir -p dist/api && cp src/api/schema.graphql dist/api/",
    "package-lambdas": "mkdir -p dist/lambdas && npm run package-graphql && npm run package-auth",
    "package-graphql": "cd dist/api && zip -r ../lambdas/graphql.zip . -x '*.ts' -x '*.map'",
    "package-auth": "cd dist/auth && zip -r ../lambdas/auth.zip . -x '*.ts' -x '*.map'",
    "migrate:dry-run": "ts-node infra/scripts/migration-runner.ts --dry-run",
    "migrate:up": "ts-node infra/scripts/migration-runner.ts up",
    "sync:search-indexes": "ts-node infra/scripts/migration-runner.ts sync-search",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test:unit": "jest --runInBand",
    "test:integration": "jest --runInBand --testPathPattern=tests/integration",
    "dev": "nodemon --watch src --exec ts-node src/api/graphql-handler.ts",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@apollo/server": "^4.9.5",
    "@as-integrations/aws-lambda": "^3.1.0",
    "aws-lambda": "^1.0.7",
    "graphql": "^16.8.1",
    "mongodb": "^6.3.0",
    "jsonwebtoken": "^9.0.2",
    "twilio": "^4.19.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/group-ops-platform.git"
  },
  "keywords": [
    "graphql",
    "mongodb",
    "serverless",
    "aws",
    "lambda",
    "events",
    "rsvp"
  ],
  "author": "Group Ops Team",
  "license": "MIT"
}